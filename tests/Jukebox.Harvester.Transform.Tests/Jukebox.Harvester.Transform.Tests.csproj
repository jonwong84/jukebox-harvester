<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
	<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  <PrivateAssets>all</PrivateAssets>
	</PackageReference>
	<PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="../../src/Jukebox.Harvester.Transform/Jukebox.Harvester.Transform.csproj" />
  </ItemGroup>

  <ItemGroup>
	<None Include="../fixtures/musicbrainz/*.json"
		  Link="fixtures/musicbrainz/%(Filename)%(Extension)"
		  CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
